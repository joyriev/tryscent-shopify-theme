<div class="relative min-h-screen bg-gradient-to-r from-gray-800 via-gray-700 to-gray-600 overflow-hidden">
  <!-- Background perfume bottles image effect -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute right-0 top-1/2 transform -translate-y-1/2 w-96 h-96 bg-gradient-to-l from-amber-900/20 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute left-1/3 bottom-0 w-64 h-64 bg-gradient-to-t from-yellow-800/20 to-transparent rounded-full blur-2xl"></div>
  </div>

  <div class="relative z-10 container mx-auto px-6 py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left side - Main content -->
      <div class="space-y-8">
        <!-- Customer rating badge -->
        <div class="inline-flex items-center bg-black/40 backdrop-blur-sm rounded-full px-4 py-2 border border-gray-600">
          <div class="flex items-center space-x-2">
            <div class="flex text-yellow-400">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
              </svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
              </svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
              </svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
              </svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
              </svg>
            </div>
            <span class="text-white font-medium">1000s Happy Customers</span>
          </div>
        </div>

        <!-- Main heading -->
        <div class="space-y-4">
          <h1 class="text-5xl lg:text-6xl font-bold text-white leading-tight">
            Create Your Bundle!
          </h1>
          <p class="text-xl text-gray-300 max-w-md">
            Best scents you've ever smelled or your money back.
          </p>
        </div>
      </div>

      <!-- Right side - Steps -->
      <div class="space-y-6">
        <!-- Step 1 -->
        <div class="flex items-start space-x-4 bg-black/20 backdrop-blur-sm rounded-2xl p-6 border border-gray-600/30">
          <div class="flex-shrink-0 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
            <span class="text-black font-bold text-sm">01</span>
          </div>
          <div>
            <h3 class="text-white font-semibold text-lg mb-1">
              Select Up To 5 Bottles To Get $100 OFF
            </h3>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex items-start space-x-4 bg-black/20 backdrop-blur-sm rounded-2xl p-6 border border-gray-600/30">
          <div class="flex-shrink-0 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
            <span class="text-black font-bold text-sm">02</span>
          </div>
          <div>
            <h3 class="text-white font-semibold text-lg mb-1">
              Get Up To 4 Bottles For
              <span class="text-green-400">FREE</span>
            </h3>
            <p class="text-gray-400">
              Get to try more scents. Keep some, give some!
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex items-start space-x-4 bg-black/20 backdrop-blur-sm rounded-2xl p-6 border border-gray-600/30">
          <div class="flex-shrink-0 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
            <span class="text-black font-bold text-sm">03</span>
          </div>
          <div>
            <h3 class="text-white font-semibold text-lg mb-1">
              Add to cart & enjoy TryScent
            </h3>
            <p class="text-gray-400">
              We offer 60-day satisfaction guarantee.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative elements to simulate perfume bottles -->
  <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-black/20 to-transparent"></div>
  <div class="absolute top-1/4 right-10 w-2 h-20 bg-gradient-to-b from-amber-600/30 to-transparent rounded-full transform rotate-12"></div>
  <div class="absolute top-1/3 right-20 w-1 h-16 bg-gradient-to-b from-yellow-600/40 to-transparent rounded-full transform -rotate-6"></div>
</div>

{% schema %}
  {
    "name": "Builder Hero",
    "presets": [
      {
        "name": "Builder Hero"
      }
    ]
  }
{% endschema %}