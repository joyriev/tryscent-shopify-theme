<div>
  <img
    src="{{ section.settings.image | image_url: 'master' }}"
    alt="Home banner"
    width="1920"
    height="1080">

  <img
    src="{{ section.settings.mobile_image | image_url: 'master' }}"
    alt="Home banner"
    width="1920"
    height="1080">
</div>

{% schema %}
  {
    "name": "Home Hero Banner",
    "settings": [
      {
        "id": "image",
        "type": "image_picker",
        "label": "Image"
      }, {
        "id": "mobile_image",
        "type": "image_picker",
        "label": "Mobile Image"
      }
    ],
    "presets": [
      {
        "name": "Home Hero Banner"
      }
    ]
  }
{% endschema %}