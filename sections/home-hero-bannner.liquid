<div>
  <a href="{{ section.settings.link }}">
    <img
      class="md:hidden"
      src="{{ section.settings.image | image_url: 'master' }}"
      alt="Home banner"
      width=""
      height="">
    <img
      class="hidden md:block"
      src="{{ section.settings.mobile_image | image_url: 'master' }}"
      alt="Home banner"
      width=""
      height="">
  </a>
</div>
{% schema %}
  {
    "name": "Home Hero Banner",
    "settings": [
      {
        "id": "image",
        "type": "image_picker",
        "label": "Image"
      }, {
        "id": "mobile_image",
        "type": "image_picker",
        "label": "Mobile Image"
      }, {
        "id": "link",
        "type": "url",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Home Hero Banner"
      }
    ]
  }
{% endschema %}