{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 my-0">{{ section.settings.heading }}</h2>
      <div class="flex flex-wrap justify-end text-right items-center gap-2">
        <img
          src="{{ 'rating-stars.svg' |  asset_url }}"
          alt="*****"
          width="80"
          height="16">
        <span class="text-sm font-medium text-slate-600">{{ section.settings.review_text }}</span>
      </div>
    </div>
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-3">
      {% for block in section.blocks %}
        <div class="mb-3 break-inside-avoid rounded-lg p-4 bg-white border border-solid border-gray-100" {{ block.shopify_attributes }}>
          <div class="flex justify-between">
            <div class="flex items-center gap-3">
              {% if block.settings.author_image != blank %}
                <img
                  class="size-8 rounded-full"
                  src="{{ block.settings.author_image |  image_url: width: 32, height: 32 }}"
                  alt="{{ block.settings.author }}"
                  width="32"
                  height="32">
              {% endif %}

              <div class="flex flex-col gap-1">
                <p class="text-sm font-bold text-slate-900 my-0">{{ block.settings.author | default: "Alex Thompson" }}</p>
                {% if block.settings.show_verified_badge %}
                  <div class="flex items-center gap-1 text-xs text-[#297af4] font-medium">
                    <img
                      src="{{ 'verified-badge.svg' | asset_url }}"
                      alt="Verified Buyer"
                      width="16"
                      height="16"
                      loading="lazy">
                    Verified Buyer
                  </div>
                {% endif %}
              </div>
            </div>
            <div class="flex flex-col items-end gap-1">
              <img
                src="{{ 'rating-stars.svg' |  asset_url }}"
                alt="*****"
                width="80"
                height="16">
              <div class="text-xs text-gray-400">{{ block.settings.date | default: "2 days ago" }}</div>
            </div>
          </div>
          <h3 class="font-bold text-slate-900 mb-2">{{ block.settings.title | default: "Absolutely love it!" }}</h3>
          <div class="text-slate-600 text-sm leading-relaxed">
            {{ block.settings.content | default: '"The fit is exactly what I was looking for. Shipping was incredibly fast, arrived in 2 days."' }}
          </div>
          {% if block.settings.product != blank %}
            <div class="border-0 border-t border-solid border-gray-100 pt-2">
              <a href="{{ block.settings.product.url }}" class="flex items-center gap-3">
                {% if block.settings.product.image != blank %}
                  <img
                    class="size-8 rounded"
                    src="{{ block.settings.product.image |  image_url: width: 32, height: 32 }}"
                    alt="{{ block.settings.product.title }}"
                    width="32"
                    height="32">
                {% endif %}

                <div class="flex flex-col gap-1">
                  <p class="text-sm font-bold text-slate-900 my-0">{{ block.settings.product.title }}</p>
                  <div>{{ block.settings.product.metafields.custom.inspiration.value.title }}</div>
                </div>
              </a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="mt-12 text-center">
      <a href="{{ section.settings.button_link }}" class="px-8 py-3 border-2 border-solid border-slate-900 no-underline text-slate-900 font-bold text-sm uppercase tracking-wide hover:bg-slate-900 hover:text-white transition-colors">
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Massive Review",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Customer Reviews"
      },
      {
        "type": "text",
        "id": "review_text",
        "label": "Review Text",
        "default": "4.9/5 based on 2,400+ reviews"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Read all reviews"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button Link",
        "default": "/collections/all"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "image_picker",
            "id": "review_image",
            "label": "Review Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Review Title",
            "default": "Absolutely love it!"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Review Content",
            "default": "<p>\"The fit is exactly what I was looking for. Shipping was incredibly fast, arrived in 2 days.\"</p>"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author Name",
            "default": "Alex Thompson"
          }, {
            "type": "image_picker",
            "id": "author_image",
            "label": "Author Image"
          }, {
            "type": "text",
            "id": "date",
            "label": "Date",
            "default": "2 days ago"
          }, {
            "type": "range",
            "id": "rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "label": "Rating",
            "default": 5
          }, {
            "type": "checkbox",
            "id": "show_verified_badge",
            "label": "Show Verified Badge",
            "default": true
          }, {
            "type": "product",
            "id": "product",
            "label": "Product"
          }

        ]
      }
    ],
    "presets": [
      {
        "name": "Massive Review"
      }
    ]
  }
{% endschema %}