{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-slate-900">{{ section.settings.heading }}</h2>
      <div class="flex items-center gap-2">
        <img
          src="{{ 'rating-stars.svg' |  asset_url }}"
          alt="*****"
          width="80"
          height="16">
        <span class="text-sm font-medium text-slate-600">{{ section.settings.review_text }}</span>
      </div>
    </div>
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-3">
      {% for block in section.blocks %}
        <div class="mb-3 break-inside-avoid rounded-lg p-8 bg-white border border-solid border-gray-100" {{ block.shopify_attributes }}>
          <div class="flex justify-between items-start mb-4">
            <div class="flex text-yellow-400">
              {% assign rating = block.settings.rating | default: 5 %}
              {% for i in (1..rating) %}
                <span>★</span>
              {% endfor %}
            </div>
            <span class="text-xs text-gray-400">{{ block.settings.date | default: "2 days ago" }}</span>
          </div>

          <h3 class="font-bold text-slate-900 mb-2">{{ block.settings.title | default: "Absolutely love it!" }}</h3>
          <div class="text-slate-600 text-sm leading-relaxed mb-6">
            {{ block.settings.content | default: '"The fit is exactly what I was looking for. Shipping was incredibly fast, arrived in 2 days."' }}
          </div>

          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-500">
              {{ block.settings.author_initials | default: block.settings.author | slice: 0 | upcase }}
            </div>

            <div>
              <p class="text-sm font-bold text-slate-900 my-0">{{ block.settings.author | default: "Alex Thompson" }}</p>
              {% if block.settings.show_verified_badge %}
                <div class="flex items-center gap-1 text-xs text-[#297af4] font-medium">
                  <img
                    src="{{ 'verified-badge.svg' | asset_url }}"
                    alt="Verified Buyer"
                    width="16"
                    height="16"
                    loading="lazy">
                  Verified Buyer
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="mt-12 text-center">
      <a href="{{ section.settings.button_link }}" class="px-8 py-3 border-2 border-solid border-slate-900 no-underline bg-slate-100 text-slate-900 font-bold text-sm uppercase tracking-wide hover:bg-slate-900 hover:text-white transition-colors">
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Massive Review",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Customer Reviews"
      },
      {
        "type": "text",
        "id": "review_text",
        "label": "Review Text",
        "default": "4.9/5 based on 2,400+ reviews"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Read all reviews"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button Link",
        "default": "/collections/all"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Review Title",
            "default": "Absolutely love it!"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Review Content",
            "default": "<p>\"The fit is exactly what I was looking for. Shipping was incredibly fast, arrived in 2 days.\"</p>"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author Name",
            "default": "Alex Thompson"
          },
          {
            "type": "text",
            "id": "author_initials",
            "label": "Author Initials",
            "default": "A"
          }, {
            "type": "text",
            "id": "date",
            "label": "Date",
            "default": "2 days ago"
          }, {
            "type": "range",
            "id": "rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "label": "Rating",
            "default": 5
          }, {
            "type": "checkbox",
            "id": "show_verified_badge",
            "label": "Show Verified Badge",
            "default": true
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Massive Review"
      }
    ]
  }
{% endschema %}