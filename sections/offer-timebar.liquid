<link rel="stylesheet" href="https://pbutcher.uk/flipdown/css/flipdown/flipdown.css">
<script defer src="https://pbutcher.uk/flipdown/js/flipdown/flipdown.js"></script>

<style>
  /* FlipDown Custom Styles */
  .flipdown {
    width: 200px;
    height: 42px;
  }

  .flipdown div:empty {
    display: block;
  }

  .flipdown .rotor {
    font-size: 1.32rem;
    margin-right: 1.8px;
  }

  .flipdown .rotor,
  .flipdown .rotor-leaf,
  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    width: 18px;
  }

  .flipdown .rotor-group {
    padding-right: 12px;
  }

  .flipdown .rotor-group:last-child {
    padding-right: 0;
  }

  .flipdown .rotor-group-heading:before {
    font-size: 0.48rem;
    height: 12px;
    line-height: 12px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    left: 41px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before {
    bottom: 7.8px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    bottom: 17.4px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-top {
    line-height: 30px;
  }

  .flipdown .rotor-leaf,
  .flipdown .rotor {
    height: 30px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    height: 15px;
  }

  .flipdown.flipdown__theme-dark .rotor-group-heading:before {
    color: #173E34;
    font-size: 8px;
    font-weight: 400;
    text-transform: uppercase;
  }

  /* Timebar Section Styles */
  .timebar-section-bg {
    display: block;
    text-decoration: none;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: #f87171;
    background-repeat: repeat;
  }

  .timebar-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
  }

  .timebar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .timebar-sale-text {
    color: white;
    font-size: 2rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .timebar-row {
      gap: 16px;
    }
  }

  /* Coupon Button Styles */
  .timebar-code-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 2px solid white;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
    color: white;
    font-size: 1rem;
    transition: 0.2s ease;
    user-select: none;
  }

  .timebar-code-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .flipdown.flipdown__theme-dark .rotor-bottom,
  .flipdown.flipdown__theme-dark .rotor-leaf-rear,
  .flipdown.flipdown__theme-dark .rotor,
  .flipdown.flipdown__theme-dark .rotor-top,
  .flipdown.flipdown__theme-dark .rotor-leaf-front,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    background-color: #173E34;
  }

  .flipdown.flipdown__theme-dark .rotor:after {
    border-color: #173E34;
  }

  {% if section.settings.countdown_date == blank %}
    .flipdown {
      width: 140px !important;
    }
    .flipdown .rotor-group:first-child {
      display: none;
    }
  {% endif %}
</style>

<div id="{{ section.id }}">
  {% if section.settings.top_banner_text != blank %}
    <div class="py-3 bg-[#173E34]">
      <div class="page-width">
        <div class="text-center text-white flex items-center justify-center gap-4 leading-none">-
          <span>{{ section.settings.top_banner_text }}</span>
          -</div>
      </div>
    </div>
  {% endif %}
  <div class="py-3 md:py-2 bg-[#DCE9DE]">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1 justify-center">
        <div class="flex flex-wrap gap-x-4 gap-y-1 items-center justify-center">
          <div class="text-[#173E34] font-bold text-xl">
            {{ section.settings.prepend_text }}
          </div>
          <a href="{{ section.settings.link }}" class="text-[#173E34] font-semibold text-lg tracking-wider md:order-1">
            {{ section.settings.append_text }}
          </a>
          <div class="flex items-center gap-2">
            <div class="text-base font-bold leading-none text-[#1F2E1F] md:hidden">
              Endet in
            </div>
            <div id="flipdown" class="flipdown"></div>
          </div>
        </div>
        {% if section.blocks.size > 0 %}
          <div class="[display:none] md:flex gap-4">
            {% for block in section.blocks %}
              <div class="flex flex-col items-center {% unless forloop.last %}pr-4 border-0 border-r border-solid border-gray-300{% endunless %}">
                <img
                  class="rounded"
                  src="{{ block.settings.icon |  image_url  }}"
                  height="25"
                  width=""
                  alt="{{ block.settings.label }}">
                <div class="leading-none text-xs mt-1 font-semibold text-black">
                  {{ block.settings.label }}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% if section.blocks.size > 0 %}
  <div class="md:hidden py-3 border-0 border-b border-solid border-gray-200">
    <div class="page-width">
      <div class="flex gap-4 justify-between">
        {% for block in section.blocks %}
          <div class="flex flex-col items-center {% unless forloop.last %}pr-4 border-0 border-r border-solid border-gray-200{% endunless %}">
            <img
              class="rounded"
              src="{{ block.settings.icon |  image_url  }}"
              height="25"
              width=""
              alt="{{ block.settings.label }}">
            <div class="leading-none text-xs mt-1 font-semibold text-black">
              {{ block.settings.label }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function getNextMidnightTimestamp() {
      const nextMidnight = new Date();

      nextMidnight.setHours(24, 0, 0, 0); // next day 00:00:00

      return Math.floor(nextMidnight.getTime() / 1000);
    }

    function getCountdownDeadline() {
      const configuredDate = {{ section.settings.countdown_date | json }};

      if (!configuredDate) {
        return getNextMidnightTimestamp();
      }

      const configuredTimestamp = Math.floor(new Date(configuredDate).getTime() / 1000);

      return Number.isNaN(configuredTimestamp) ? getNextMidnightTimestamp() : configuredTimestamp;
    }

    const deadline = getCountdownDeadline();

    new FlipDown(deadline, {
      headings: ["Dag", "Tim", "Min", "Sek"],
    })
      .start()
      .ifEnded(() => {
        console.log('Countdown ended');
      });
  });
</script>

{% schema %}
  {
    "name": "Offer Timebar",
    "settings": [
      {
        "type": "text",
        "id": "top_banner_text",
        "label": "Top Banner Text",
        "info": "Leaving this field will disable the banner."
      },
      {
        "type": "text",
        "id": "prepend_text",
        "label": "Prepend Text",
        "default": "Exclusive Offer"
      },
      {
        "type": "text",
        "id": "countdown_date",
        "label": "End Date and Time",
        "info": "Format: YYYY/MM/DD HH:MM:SS (e.g., 2026/12/25 23:59:59)"
      },
      {
        "type": "text",
        "id": "append_text",
        "label": "Append Text",
        "default": "Shop Now 👉"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "blocks": [
      {
        "type": "payment_icon",
        "name": "Payment Icon",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Offer Timebar"
      }
    ]
  }
{% endschema %}