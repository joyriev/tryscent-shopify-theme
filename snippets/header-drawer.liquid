{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <div class="grid-cols-2 px-6 gap-4 [display:none]">
              <a class="d-block no-underline text-black" href="https://tryscent.co/collections/all">
                <img
                  class="w-full h-auto"
                  src="https://cdn.shopify.com/s/files/1/0762/7662/9763/files/shop-all.png?v=1755249219"
                  height="auto"
                  width="full"
                  alt="Shop All">
                <p class="my-0 font-semibold text-center leading-snug">Shop All</p>
              </a>
              <a class="d-block no-underline text-black" href="https://tryscent.co/pages/build-your-bundle/">
                <img
                  class="w-full h-auto"
                  src="https://cdn.shopify.com/s/files/1/0762/7662/9763/files/create-bundle.png?v=1755249632"
                  height="auto"
                  width="full"
                  alt="Create Bundle">
                <p class="my-0 font-semibold text-center leading-snug">Create Bundle</p>
              </a>
              <a class="d-block no-underline text-black" href="https://tryscent.co/collections/man">
                <img
                  class="w-full h-auto"
                  src="https://cdn.shopify.com/s/files/1/0762/7662/9763/files/for-men.png?v=1755251211"
                  height="auto"
                  width="full"
                  alt="For Men">
                <p class="my-0 font-semibold text-center leading-snug">For Men</p>
              </a>
              <a class="d-block no-underline text-black" href="https://tryscent.co/collections/woman">
                <img
                  class="w-full h-auto"
                  src="https://cdn.shopify.com/s/files/1/0762/7662/9763/files/for-women.png?v=1755251279"
                  height="auto"
                  width="full"
                  alt="For Women">
                <p class="my-0 font-semibold text-center leading-snug">For Women</p>
              </a>
            </div>
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary id="HeaderDrawer-{{ link.handle }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                        {{ link.title | escape }}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1">
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>
                          <ul
                            class="!px-6 menu-drawer__menu list-menu"
                            role="list"
                            tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                    aria-current="page"
                                    {% endif %}>
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div id="childlink-{{ childlink.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="!px-6 menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                              aria-current="page"
                                              {% endif %}>
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                      aria-current="page"
                      {% endif %}>
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          <div class="!px-6 bg-white grid-cols-3 gap-4 text-center mb-0 py-4 [display:none]">
            <div>
              <img
                src="https://tryscent.co/cdn/shop/files/sandwatch.svg?v=1753955350"
                alt="Lasts 12+ Hours"
                width="30"
                height="30">
              <p class="leading-none uppercase text-xs my-0">
                Lasts 12+ Hours
              </p>
            </div>
            <div>
              <img
                src="https://tryscent.co/cdn/shop/files/sheild-star.svg?v=1753955264"
                alt="Lasts 12+ Hours"
                width="30"
                height="30">
              <p class="leading-none uppercase text-xs my-0">
                60 day satisfaction guarantee
              </p>
            </div>
            <div>
              <img
                src="https://tryscent.co/cdn/shop/files/heart.svg?v=1753955924"
                alt="Lasts 12+ Hours"
                width="30"
                height="30">
              <p class="leading-none uppercase text-xs my-0">
                loved by 10,000+
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>