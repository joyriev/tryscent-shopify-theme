{%- liquid
  assign review_items = ''
  for i in (1..5)
    assign name_key = 'name_' | append: i
    assign text_key = 'text_' | append: i
    if block.settings[name_key] != blank or block.settings[text_key] != blank
      assign review_items = review_items | append: i | append: ','
    endif
  endfor
  assign review_items = review_items | split: ','
-%}

{%- if review_items.size > 0 -%}
  <div class="swiper review-slider-{{ block.id }} my-6 overflow-hidden" {{ block.shopify_attributes }}>
    <div class="swiper-wrapper items-start">
      {%- comment -%}
        Slides are rendered twice so Swiper always has enough slides for a
        seamless loop while showing 1 slide per view.
      {%- endcomment -%}
      {%- for pass in (1..2) -%}
        {%- for item in review_items -%}
          {%- assign name_key = 'name_' | append: item -%}
          {%- assign text_key = 'text_' | append: item -%}
          {%- assign review_name = block.settings[name_key] -%}
          {%- assign review_text = block.settings[text_key] -%}
          <div
            class="swiper-slide h-auto text-center"
            {% if pass == 2 %}
            aria-hidden="true"
            {% endif %}>
            <img
              src="{{ 'rating-stars.svg' | asset_url }}"
              alt="5 stars"
              width="66"
              height="13"
              loading="lazy"
              class="mx-auto h-3 w-auto mb-2">
            {%- if review_text != blank -%}
              <p class="my-0 text-sm md:text-base leading-snug text-gray-800">
                {{- review_text -}}
              </p>
            {%- endif -%}
            {%- if review_name != blank -%}
              <p class="mt-2 mb-0 text-sm font-bold text-gray-900">
                {{- review_name -}}
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      new Swiper('.review-slider-{{ block.id }}', {
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        loopAdditionalSlides: {{ review_items.size }},
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
        },
      });
    });
  </script>
{%- endif -%}
