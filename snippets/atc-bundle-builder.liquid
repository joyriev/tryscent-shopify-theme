<style>
  [x-cloak] {
    display: none !important;
  }
</style>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<div x-data>
  <div class="border border-solid border-gray-200 bg-white rounded-lg p-8 mb-6">
    <h2 class="text-3xl font-bold text-gray-900 my-0">Buy 3 Get 1 FREE</h2>
    <p class="text-lg text-green-700 font-semibold my-2">Build your bundle and get one scent for FREE!</p>
    <div class="grid grid-cols-3 gap-4 mt-8">
      <div class="relative">
        <img
          src="{{ product.featured_image | image_url }}"
          alt="Rough Perfume"
          width=""
          height=""
          class="object-cover rounded w-full">
        <div class="absolute top-0 left-0 [rotate:-20deg]">
          <span class="bg-red-500 text-white px-3 py-1 rounded font-bold text-xs">FREE</span>
        </div>
      </div>

      <div class="text-left relative col-span-2">
        <p class="text-gray-600 mb-1 mt-0">Smells like</p>
        <h3 class="text-2xl font-bold text-gray-900 mb-2 mt-0">{{ product.title | remove: 'Smells like...' | remove: 'Smells like ...' }}</h3>
        <p class="text-gray-700 my-0 line-clamp-2">{{ product.metafields.custom.scent_breakdown | metafield_text }}</p>
        <div class="absolute top-0 right-0">
          <span class="text-gray-600 text-lg">50ML</span>
        </div>
      </div>
    </div>
  </div>
  <!-- Add Products Section -->
  <div x-cloak>
    <div class="text-center mb-6">
      <h3 class="text-xl font-bold text-gray-900 my-0 relative before:content-[''] before:block before:w-full before:h-[1px] before:bg-gray-200 before:absolute before:top-1/2 before:left-0 before:z-[-1]">
        <span class="bg-[#faf9f6] inline-block px-4" x-text="$store.bundleBuilder.selectedProducts.length === 3 ? 'YOUR BUNDLE IS READY! 👑' : `ADD ${3 - $store.bundleBuilder.selectedProducts.length} MORE SCENT${3 - $store.bundleBuilder.selectedProducts.length > 1 ? 'S' : ''}`">ADD 3 MORE SCENTS</span>
      </h3>
    </div>
    <div class="grid grid-cols-3 gap-4 pb-4 mb-6 border-0 border-b border-solid border-gray-200">
      <template x-for="(product, index) in $store.bundleBuilder.selectedProducts" :key="product.id">
        <div class="text-center relative">
          <div class="flex justify-center mb-4 border-2 border-solid border-green-700 rounded-lg">
            <button @click="$store.bundleBuilder.removeProduct(index)" class="absolute top-2 right-2 w-6 h-6 p-0 flex items-center justify-center bg-white rounded-full text-xs cursor-pointer border-0 shadow">
              <svg
                width="10"
                height="12"
                viewBox="0 0 10 12"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M9.92817 2.16875C9.85317 1.8875 9.80317 1.73125 9.80317 1.73125C9.72192 1.44063 9.51567 1.44062 9.20942 1.39062L7.55005 1.18125C7.3438 1.14688 7.3438 1.14688 7.26255 0.96875C6.99067 0.35625 6.9063 0 6.60942 0H3.39067C3.0938 0 3.01255 0.35625 2.74067 0.971875C2.65942 1.14687 2.65942 1.14688 2.45317 1.18438L0.790672 1.39375C0.487547 1.44375 0.268797 1.47188 0.187547 1.7625C0.187547 1.7625 0.150047 1.89062 0.0719217 2.16875C-0.0280783 2.54062 -0.0687033 2.5 0.275047 2.5H9.72505C10.0688 2.50312 10.0313 2.54062 9.92817 2.16875ZM8.8563 3.5H1.1438C0.625047 3.5 0.600047 3.56875 0.631297 3.95937L1.21567 11.5406C1.26567 11.925 1.30317 12.0031 1.76255 12.0031H8.23755C8.69692 12.0031 8.73442 11.925 8.78442 11.5406L9.3688 3.95937C9.40005 3.56562 9.37505 3.5 8.8563 3.5Z" fill="#868686" />
              </svg>
            </button>
            <img
              :src="product.image"
              :alt="product.name"
              class="w-full aspect-square object-cover rounded-lg"
              width=""
              height="">
          </div>
          <p class="text-gray-600 text-sm my-0">Smells like</p>
          <h4 class="font-bold text-gray-900 my-0 uppercase" x-text="product.name"></h4>
          <p class="text-gray-900 my-0" x-text="product.price"></p>
        </div>
      </template>
      <template x-for="i in (3 - $store.bundleBuilder.selectedProducts.length)" :key="i">
        <div class="text-center">
          <div class="border-2 border-dashed bg-white border-gray-300 rounded-lg grid place-items-center w-full aspect-square">
            <button @click="$store.bundleBuilder.showModal = true" class="w-16 h-16 border-0 bg-green-700 text-white rounded-lg text-2xl hover:bg-green-700 transition-colors cursor-pointer">
              <div class="svg-wrapper">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </div>
            </button>
          </div>
          <p class="text-gray-700 mt-4 font-medium mb-0">Add Scent</p>
        </div>
      </template>
    </div>

    {% comment %} Savings Display {% endcomment %}
    <div class="text-center mb-6" x-show="$store.bundleBuilder.selectedProducts.length === 3">
      <div class="flex justify-center gap-2 items-center italic font-semibold text-lg tracking-tight flex-wrap">
        <div class="text-gray-400 line-through">
          {{ cart.currency.symbol }}
          <span x-text="$store.bundleBuilder.originalTotal.toFixed(2)"></span>
        </div>
        <div class="text-red-600">
          {{ cart.currency.symbol }}
          <span x-text="$store.bundleBuilder.bundleTotal.toFixed(2)"></span>
        </div>
        <div class="text-green-700 inline-block ml-2">🎉 You Save
          <span x-text="$store.bundleBuilder.availableProducts[0].price"></span>!</div>
      </div>
    </div>
    <button
      @click="$store.bundleBuilder.addBundleToCart()"
      :disabled="$store.bundleBuilder.selectedProducts.length !== 3 || $store.bundleBuilder.addingToCart"
      class="w-full bg-green-800 text-white py-4 px-6 rounded-lg font-bold text-2xl hover:bg-green-900 transition-colors cursor-pointer disabled:cursor-not-allowed disabled:bg-gray-400 border-0 disabled:shadow-none"
      x-bind:class="{'opacity-75': $store.bundleBuilder.addingToCart}">
      <span x-show="!$store.bundleBuilder.addingToCart" x-text="$store.bundleBuilder.selectedProducts.length === 3 ? 'Add Bundle to Cart' : 'Complete the Bundle'"></span>
      <span x-show="$store.bundleBuilder.addingToCart">Adding Bundle to Cart...</span>
    </button>
  </div>
</div>

{% comment %} Shadow Product Form for the main product {% endcomment %}
{% liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign main_variant = product.selected_or_first_available_variant
  for variant in product.variants
    if variant.title == '50ML'
      assign main_variant = variant
    endif
  endfor
%}

<product-form
  class="product-form !m-0"
  data-hide-errors="{{ gift_card_recipient_feature_active }}"
  data-section-id="{{ section.id }}">
  {%- form 'product'
    , product
    , id: product_form_id
    , class: 'form'
    , novalidate: 'novalidate'
    , data-type: 'add-to-cart-form'
  -%}
    <input
      type="hidden"
      name="id"
      value="{{ main_variant.id }}"
      class="product-variant-id">
    <button
      type="submit"
      name="add"
      value="1"
      class="shadow_atc_button_for_bundle_builder h-0 w-0 visibility-hidden overflow-hidden fixed -top-[99999px] -left-[99999px]"
      aria-label="Add to cart">
      <span>Add to cart</span>
      {%- render 'loading-spinner' -%}
    </button>
  {%- endform -%}
</product-form>

{% assign bundle_collection = collections['smells-like'] %}
{% unless bundle_collection %}
  {% assign bundle_collection = collections.first %}
{% endunless %}

<script>
  document.addEventListener('alpine:init', function() {
    Alpine.store('bundleBuilder', {
      showModal: false,
      activeCategory: "All",
      selectedBrand: "",
      searchText: "",
      addingToCart: false,
      selectedProducts: [],
      availableProducts: [
        {% for bundle_product in bundle_collection.products %}
          {% liquid
            assign selected_variant = bundle_product.selected_or_first_available_variant
            for variant in bundle_product.variants
              if variant.title == '50ML'
                assign selected_variant = variant
              endif
            endfor
          %}
          {
            id: {{ selected_variant.id }},
            name: "{{ bundle_product.title | remove: 'Smells like...' | remove: 'Smells like ...' }}",
            price: "{{ selected_variant.price | money }}",
            image: "{{ bundle_product.featured_image | image_url }}",
            ratingCount: "{{ bundle_product.metafields.reviews.rating_count }}",
            tags: {{ bundle_product.tags | json }}
          },
        {% endfor %}
      ],
      get originalTotal() {
        return parseFloat(this.availableProducts[0].price.replace(/[^0-9.]/g, '')) * 4;
      },
      get bundleTotal() {
        return parseFloat(this.availableProducts[0].price.replace(/[^0-9.]/g, '')) * 3;
      },
      addProduct(product) {
        if (this.selectedProducts.length < 3 && !this.isProductSelected(product.id)) {
          this.selectedProducts.push(product);
          if (this.selectedProducts.length === 3) {
            Alpine.store('bundleModal').show = false;
          }
        }
      },
      removeProduct(index) {
        this.selectedProducts.splice(index, 1);
      },
      isProductSelected(productId) {
        return this.selectedProducts.some(product => product.id === productId);
      },
      addBundleToCart() {
        this.addingToCart = true;
        const itemsToAdd = this.selectedProducts.map(product => ({
          id: product.id,
          quantity: 1
        }));
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items: itemsToAdd })
        })
        .then(res => res.json())
        .then(data => {

          const shadowAtcButton = document.querySelector('.shadow_atc_button_for_bundle_builder');
          shadowAtcButton.click();

          setTimeout(() => {
            this.addingToCart = false;
          }, 3000);
        })
        .catch(err => console.error(err));
      }
    });
  });
</script>