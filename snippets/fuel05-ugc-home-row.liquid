          product_item: all_products['magic-perfume-no-360m']
        %}
        {% render 'fuel05-ugc-tile',
          video_url: 'https://tryscent.co/cdn/shop/videos/c/vp/f5fcc4ff10f64169ae5095bfe2f58bcc/f5fcc4ff10f64169ae5095bfe2f58bcc.HD-1080p-7.2Mbps-92843390.mp4?v=0',
