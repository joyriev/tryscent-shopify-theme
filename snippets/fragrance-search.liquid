  // ===== HITTA REKOMMENDERAD PRODUKT =====
  function getRecommendationForProduct(product) {
    if (!product || !product.number) return null;
    
    // Kolla om det finns en hårdkodad rekommendation
    const recNumber = hardcodedRecommendations[product.number];
    if (recNumber && recNumber !== product.number) {
      const recommended = hardcodedProducts.find(p => p.number === recNumber);
      if (recommended) return recommended;
    }
    
    // Fallback: annan produkt från samma brand med samma kön
    const sameBrand = hardcodedProducts.find(p => 
      p.brandKey === product.brandKey && 
      p.id !== product.id &&
      p.gender === product.gender
    );
    
    return sameBrand || null;
  }

  // ===== NORMALISERA TEXT FÖR SÖKNING (hanterar åäö) =====
  function normalizeText(text) {
    if (!text) return '';
    return text.toLowerCase()
      .replace(/[åä]/g, 'a')
      .replace(/[ö]/g, 'o')
      .replace(/[^a-z0-9]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  // ===== UTFÖR SÖKNING I VÅRA PRODUKTER =====
  function searchProducts(query) {
    if (!query || query.length < 1) return [];
    
    const normalizedQuery = normalizeText(query);
    const queryNoSpaces = normalizedQuery.replace(/\s+/g, '');
    const results = [];
    const addedIds = new Set();
    
    hardcodedProducts.forEach(product => {
      let bestScore = 0;
      const searchText = normalizeText(product.title);
      const searchTextNoSpaces = searchText.replace(/\s+/g, '');
      
      // Exact match (högsta poäng)
      if (searchText === normalizedQuery || searchTextNoSpaces === queryNoSpaces) {
        bestScore = 100;
      }
      // Innehåller match
      else if (searchText.includes(normalizedQuery) || searchTextNoSpaces.includes(queryNoSpaces)) {
        bestScore = 90;
      }
      // Produktnummer match
      else if (product.number && product.number === query) {
        bestScore = 95;
      }
      // Sök i searchTerms
      else if (product.searchTerms) {
        for (const term of product.searchTerms) {
          const normTerm = normalizeText(term);
          if (normTerm.includes(normalizedQuery) || normalizedQuery.includes(normTerm)) {
            bestScore = Math.max(bestScore, 85);
          }
        }
      }
      // Brand match
      else if (product.brand) {
        const normBrand = normalizeText(product.brand);
        if (normBrand.includes(normalizedQuery) || normalizedQuery.includes(normBrand)) {
          bestScore = Math.max(bestScore, 80);
        }
      }
      
      if (bestScore > 50 && !addedIds.has(product.id)) {
        results.push({ product, score: bestScore });
        addedIds.add(product.id);
      }
    });
    
    return results.sort((a, b) => b.score - a.score);
  }

