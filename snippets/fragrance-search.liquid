  // ===== GET RECOMMENDATIONS =====
  function getRecommendationsForProduct(product) {
    if (!product) return [];
    
    console.log('🎯 Getting recommendations for:', product.title);
    
    // First check for custom hardcoded recommendation
    if (product.number && hardcodedRecommendations[product.number]) {
      const recNumber = hardcodedRecommendations[product.number];
      const customRec = hardcodedProducts.find(p => p.number === recNumber);
      if (customRec) {
        console.log('✅ Found custom recommendation:', customRec.title);
        return [customRec];
      }
    }
    
    // Fall back to same brand recommendations
    const recommendations = hardcodedProducts
      .filter(p => 
        p.brandKey === product.brandKey && 
        p.id !== product.id &&
        p.gender === product.gender
      )
      .slice(0, 1);
    
    console.log(`💡 Found ${recommendations.length} same-brand recommendations`);
    
    return recommendations;
  }

  // ===== GET POPULAR PRODUCTS FOR SUGGESTIONS =====
  function getPopularSuggestions() {
    return hardcodedProducts.slice(0, 8);
  }

  // ===== RENDER SUGGESTIONS =====
  function renderSuggestions() {
    const suggestions = getPopularSuggestions();
    
    if (suggestions.length === 0) return '';
    
    let html = `<div class="fc-suggestions-title">✨ Populära dofter</div>`;
    
    suggestions.forEach(product => {
      const priceFormatted = (product.price / 100).toFixed(2) + ' kr';
      
      html += `
        <div class="fc-suggestion-item" onclick="window.fcViewDetails('${product.url}')">
          <img class="fc-suggestion-image" src="${product.image}" alt="${product.title}" loading="lazy">
          <div class="fc-suggestion-info">
            <div class="fc-suggestion-name">${product.title}</div>
            <div class="fc-suggestion-price">${priceFormatted}</div>
          </div>
        </div>
      `;
    });
    
    return html;
  }

  // ===== RENDER CATALOG PERFUME LIST =====
  function renderCatalogPerfumes(perfumes, query) {
    if (!perfumes || perfumes.length === 0) return '';
    
    const sortedPerfumes = [...perfumes].sort((a, b) => a.name.localeCompare(b.name));
    
    let html = `<div class="fc-section-title">✨ Äkta parfymer (${perfumes.length})</div>`;
    
    sortedPerfumes.slice(0, 8).forEach(perfume => {
      html += `
        <div class="fc-real-perfume-item" onclick="window.fcShowPerfumeDetail('${perfume.id}')">
          <img class="fc-real-perfume-image" src="${perfume.image}" 
               alt="${perfume.name}" 
               loading="lazy"
               onerror="this.src='https://via.placeholder.com/60x60?text=Parfym'">
          <div class="fc-real-perfume-info">
            <div class="fc-real-perfume-name">${perfume.name}</div>
            <div class="fc-real-perfume-brand">${perfume.brand}</div>
            ${perfume.year ? `<div class="fc-real-perfume-year">${perfume.year}</div>` : ''}
          </div>
        </div>
      `;
    });
    
    return html;
  }

  // ===== RENDER HARDCODED PRODUCT CARD =====
  function renderHardcodedProductCard(product, badge) {
    const priceFormatted = (product.price / 100).toFixed(2) + ' kr';
    
    return `
      <div class="fc-product-card">
        <div class="fc-badge">${badge}</div>
        <div class="fc-product-inner">
          <img class="fc-product-image" src="${product.image}" alt="${product.title}" loading="lazy">
          <div class="fc-product-title">${product.title}</div>
          <div class="fc-product-price">${priceFormatted}</div>
          <button class="fc-add-to-cart" onclick="event.stopPropagation(); window.fcAddToCart(${product.variant}, event)">Lägg i varukorg</button>
          <div>
            <span class="fc-view-link" onclick="event.stopPropagation(); window.fcViewDetails('${product.url}')">Se detaljer</span>
          </div>
        </div>
      </div>
    `;
  }

  // ===== SHOW PERFUME DETAIL =====
  window.fcShowPerfumeDetail = function(perfumeId) {
    const perfume = findPerfumeById(perfumeId);
    if (!perfume) return;
    
    currentView = 'detail';
    steps.style.display = 'none';
    
    // Find matching hardcoded product
    const hardcodedProduct = findHardcodedProductByPerfume(perfume);
    
    let html = `
      <button class="fc-back-btn" onclick="window.fcGoBack()">Tillbaka</button>
    `;
    
    if (hardcodedProduct) {
      html += `<div class="fc-subsection-title">Vår inspirerade version</div>`;
      html += '<div class="fc-grid-2col">';
      
      // RECOMMENDED: The found product
      html += renderHardcodedProductCard(hardcodedProduct, 'Rekommenderad');
      
      // YOU MIGHT LIKE IT
      const recommendations = getRecommendationsForProduct(hardcodedProduct);
      
      if (recommendations.length > 0) {
        html += renderHardcodedProductCard(recommendations[0], 'Du kanske också gillar');
      } else {
        html += `<div class="fc-product-card" style="visibility: hidden;"></div>`;
      }
      
      html += '</div>';
    } else {
      html += `<div class="fc-subsection-title">Ingen matchande produkt hittades</div>`;
    }
    
    // Show catalog perfume details
    html += `
      <div class="fc-detailed-view">
        <div class="fc-detailed-header">
          <img class="fc-detailed-image" src="${perfume.image}" 
               alt="${perfume.name}"
               loading="lazy"
               onerror="this.src='https://via.placeholder.com/110x110?text=Parfym'">
          <div>
            <div class="fc-detailed-name">${perfume.name}</div>
            <div class="fc-detailed-brand">${perfume.brand}</div>
            ${perfume.inspiredBy ? `<div class="fc-detailed-meta">Inspirerad av: ${perfume.inspiredBy}</div>` : ''}
            ${perfume.year ? `<div class="fc-detailed-meta">${perfume.year}</div>` : ''}
            ${perfume.gender ? `<div class="fc-detailed-meta">${perfume.gender}</div>` : ''}
          </div>
        </div>

        <div class="fc-notes-section">
          ${perfume.top_notes ? `
            <div class="fc-note-category">
              <h4>TOPPMOT</h4>
              <div class="fc-note-tags">
                ${perfume.top_notes.map(note => `<span class="fc-note-tag">${note}</span>`).join('')}
              </div>
            </div>
          ` : ''}
          
          ${perfume.heart_notes ? `
            <div class="fc-note-category">
              <h4>HJÄRTPARTI</h4>
              <div class="fc-note-tags">
                ${perfume.heart_notes.map(note => `<span class="fc-note-tag">${note}</span>`).join('')}
              </div>
            </div>
          ` : ''}
          
          ${perfume.base_notes ? `
            <div class="fc-note-category">
              <h4>BASNOTER</h4>
              <div class="fc-note-tags">
                ${perfume.base_notes.map(note => `<span class="fc-note-tag">${note}</span>`).join('')}
              </div>
            </div>
          ` : ''}
        </div>
        
        <div class="fc-description">
          ${perfume.description}
        </div>
      </div>
    `;
    
    content.innerHTML = html;
  };

  // ===== ADD TO CART =====
  window.fcAddToCart = function(variantId, event) {
    if (event) event.stopPropagation();
    
    const btn = event?.target || document.activeElement;
    const originalText = btn.innerText;
    
    btn.innerText = 'Lägger till...';
    btn.disabled = true;
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
      btn.innerText = '✓ Tillagd!';
      btn.style.background = '#2E7D32';
      
      fetchCartAndUpdate().then(cart => {
        showNotification(`✓ Tillagd! ${cart.item_count}/3 produkter för gratis gåva`);
      });
      
      setTimeout(() => {
        btn.innerText = originalText;
        btn.style.background = '#C41E3A';
        btn.disabled = false;
      }, 2000);
    })
    .catch(error => {
      btn.innerText = 'Fel';
      setTimeout(() => {
        btn.innerText = originalText;
        btn.disabled = false;
      }, 2000);
    });
    
    return false;
  };

  // ===== VIEW DETAILS =====
  window.fcViewDetails = function(url) {
    window.location.href = url;
  };

  // ===== GO BACK =====
  window.fcGoBack = function() {
    currentView = 'search';
    if (currentSearchQuery.length >= 1) {
      performSearch(currentSearchQuery);
    } else {
      steps.style.display = 'block';
      content.innerHTML = '';
    }
  };

  // ===== SHOW NOTIFICATION =====
  function showNotification(message) {
    let notification = document.querySelector('.fc-notification');
    if (!notification) {
      notification = document.createElement('div');
      notification.className = 'fc-notification';
      document.body.appendChild(notification);
    }
    
    notification.textContent = message;
    notification.classList.add('show');
    
    setTimeout(() => {
      notification.classList.remove('show');
    }, 2000);
  }

  // ===== UPDATE OFFER DISPLAY =====
  function updateOfferDisplay(itemCount) {
    if (!offerStatus || !offerProgress || !offerMessage || !offerSubtext) return;
    
    const percentage = Math.min((itemCount / 3) * 100, 100);
    offerProgress.style.width = percentage + '%';
    
    if (itemCount >= 3) {
      offerStatus.textContent = '🎉 GRATIS!';
      offerSubtext.textContent = 'Du kvalificerar dig för en gratis gåva!';
      offerMessage.textContent = '🎉 Du kvalificerar dig för en GRATIS gåva!';
      offerBanner.classList.add('qualified');
    } else {
      const needed = 3 - itemCount;
      offerStatus.textContent = `${itemCount}/3`;
      offerSubtext.textContent = `Lägg till ${needed} fler för en gratis gåva`;
      offerMessage.textContent = `Lägg till ${needed} fler produkter för en gratis gåva`;
      offerBanner.classList.remove('qualified');
    }
  }

  // ===== FETCH CART AND UPDATE COUNT =====
  window.fetchCartAndUpdate = function() {
    return fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        updateOfferDisplay(cart.item_count);
        return cart;
      })
      .catch(() => ({ item_count: 0 }));
  };

  // ===== PERFORM SEARCH =====
  function performSearch(query) {
    currentSearchQuery = query;
    content.innerHTML = '<div class="fc-loading">Söker...</div>';
    
    setTimeout(() => {
      // Search in hardcoded products with enhanced fuzzy search
      const hardcodedResults = searchHardcodedProducts(query);
      
      // ===== SIMPLIFIED CATALOG SEARCH =====
      const catalogResults = [];
      const queryLower = query.toLowerCase().trim();
      const queryNormalized = normalizeText(queryLower);
      
      allPerfumes.forEach(perfume => {
        const perfumeName = perfume.name.toLowerCase();
        const perfumeBrand = perfume.brand.toLowerCase();
        
        let score = 0;
        
        // Direct matches
        if (perfumeName === queryLower || perfumeBrand === queryLower) {
          score = 100;
        } else if (perfumeName.includes(queryLower) || perfumeBrand.includes(queryLower)) {
          score = 80;
        } else if (perfume.inspiredBy && perfume.inspiredBy.toLowerCase().includes(queryLower)) {
          score = 70;
        } else {
          // Fuzzy matching
          const nameScore = calculateFuzzyScore(queryLower, perfumeName);
          const brandScore = calculateFuzzyScore(queryLower, perfumeBrand);
          const bestScore = Math.max(nameScore, brandScore);
          
          if (bestScore > 60) {
            score = bestScore;
          }
        }
        
        if (score > 50) {
          catalogResults.push({ perfume, score });
        }
      });
      
      catalogResults.sort((a, b) => b.score - a.score);
      
      let html = '';
      
      // Show catalog results first
      if (catalogResults.length > 0) {
        html += `<div class="fc-section-title">✨ Äkta parfymer</div>`;
        
        catalogResults.slice(0, 8).forEach(result => {
          const perfume = result.perfume;
          html += `
            <div class="fc-real-perfume-item" onclick="window.fcShowPerfumeDetail('${perfume.id}')">
              <img class="fc-real-perfume-image" src="${perfume.image}" 
                   alt="${perfume.name}" 
                   loading="lazy"
                   onerror="this.src='https://via.placeholder.com/60x60?text=Parfym'">
              <div class="fc-real-perfume-info">
                <div class="fc-real-perfume-name">${perfume.name}</div>
                <div class="fc-real-perfume-brand">${perfume.brand}</div>
                ${perfume.inspiredBy ? `<div class="fc-real-perfume-year">Inspirerad av: ${perfume.inspiredBy}</div>` : ''}
              </div>
            </div>
          `;
        });
      }
      
      // Show hardcoded results
      if (hardcodedResults.length > 0) {
        html += `<div class="fc-section-title">🛍️ Vår kollektion</div>`;
        
        hardcodedResults.slice(0, 12).forEach(match => {
          const p = match.product;
          const priceFormatted = (p.price / 100).toFixed(2) + ' kr';
          
          html += `
            <div class="fc-real-perfume-item" onclick="window.fcViewDetails('${p.url}')">
              <img class="fc-real-perfume-image" src="${p.image}" alt="${p.title}" loading="lazy">
              <div class="fc-real-perfume-info">
                <div class="fc-real-perfume-name">${p.title}</div>
                <div class="fc-real-perfume-year">${priceFormatted}</div>
              </div>
            </div>
          `;
        });
      }
      
      // If no results at all, show suggestions
      if (catalogResults.length === 0 && hardcodedResults.length === 0) {
        html = '<div class="fc-no-results">Inga produkter hittades för "' + query + '"</div>';
        html += renderSuggestions();
      }
      
      content.innerHTML = html;
    }, 300);
  }

  // ===== SEARCH HANDLER =====
  function fcHandleSearch() {
    const query = searchInput.value.trim();
    
    if (query.length < 1) {
      if (currentView !== 'detail') {
        steps.style.display = 'block';
        content.innerHTML = '';
      }
      return;
    }
    
    steps.style.display = 'none';
    currentView = 'search';
    
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => performSearch(query), 300);
  }

  // ===== INITIALIZE =====
  document.addEventListener('DOMContentLoaded', function() {
    combineCatalogs();
    
    if (searchInput) {
      searchInput.addEventListener('keyup', fcHandleSearch);
    }
    
    if (clearSearch) {
      clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.focus();
        steps.style.display = 'block';
        content.innerHTML = '';
        currentView = 'search';
      });
    }
    
    setTimeout(fetchCartAndUpdate, 500);
    
    // Click outside to close
    document.addEventListener('click', function(event) {
      const searchPopup = document.getElementById('fcSearchPopup');
      const stickyButton = document.getElementById('fcStickyButton');
      
      if (searchPopup && searchPopup.contains(event.target)) return;
      if (stickyButton && stickyButton.contains(event.target)) return;
      if (event.target.closest('.fc-real-perfume-item')) return;
      if (event.target.closest('.fc-product-card')) return;
      if (event.target.closest('.fc-add-to-cart') || event.target.closest('.fc-view-link') || event.target.closest('.fc-back-btn')) return;
      
      if (searchPopup && searchPopup.classList.contains('active')) {
        searchPopup.classList.remove('active');
      }
    });
    
    // Escape key handler
    document.addEventListener('keydown', function(e) {
      const searchPopup = document.getElementById('fcSearchPopup');
      if (e.key === 'Escape' && searchPopup && searchPopup.classList.contains('active')) {
        searchPopup.classList.remove('active');
      }
    });
    
    console.log('✓ Fragrance Search initialized for Swedish site');
  });
})();
</script>