    const queryNoSpaces = normalizedQuery.replace(/\s+/g, '');
    const results = [];
    
    for (let brandKey in window.SwedishPerfumeCatalog) {
      if (brandKey.startsWith('_')) continue;
      const perfumes = window.SwedishPerfumeCatalog[brandKey];
      if (!Array.isArray(perfumes)) continue;
      
      perfumes.forEach(perfume => {
        let score = 0;
        const searchName = normalizeText(perfume.name);
        const searchBrand = normalizeText(perfume.brand);
        const searchNameNoSpaces = searchName.replace(/\s+/g, '');
        
        if (searchName === normalizedQuery || searchNameNoSpaces === queryNoSpaces) {
          score = 100;
        } else if (searchName.includes(normalizedQuery) || searchNameNoSpaces.includes(queryNoSpaces)) {
          score = 90;
        } else if (searchBrand.includes(normalizedQuery)) {
          score = 80;
        } else if (perfume.productNumbers && perfume.productNumbers.some(num => num === query)) {
          score = 95;
        }
        
        if (score > 60) {
          results.push({ perfume, score });
        }
      });
    }
    
    return results.sort((a, b) => b.score - a.score);
  }

  // ===== RENDERA PRODUKTKORT =====
  function renderProductCard(product, badge) {
    const priceFormatted = (product.price / 100).toFixed(2).replace('.', ',') + ' kr';
    
    return `
      <div class="fc-product-card">
        <div class="fc-badge">${badge}</div>
        <div class="fc-product-inner">
          <img class="fc-product-image" src="${product.image}" alt="${product.title}" loading="lazy">
          <div class="fc-product-title">${product.title}</div>
          <div class="fc-product-price">${priceFormatted}</div>
          <button class="fc-add-to-cart" onclick="event.stopPropagation(); window.fcAddToCart(${product.variant}, event)">Lägg i varukorg</button>
          <div>
            <span class="fc-view-link" onclick="event.stopPropagation(); window.fcViewDetails('${product.url}')">Se detaljer</span>
          </div>
        </div>
      </div>
    `;
  }

  // ===== VISA DETALJER FÖR RIKTIG PARFYM =====
  window.fcShowPerfumeDetail = function(perfumeId) {
    const perfume = window.SwedishPerfumeCatalog._index[perfumeId];
    if (!perfume) return;
    
    currentView = 'detail';
    steps.style.display = 'none';
    
    // Hitta matchande produkt från vår kollektion
    const ourProduct = hardcodedProducts.find(p => 
      perfume.productNumbers && perfume.productNumbers.includes(p.number)
    );
    
    let html = `<button class="fc-back-btn" onclick="window.fcGoBack()">Tillbaka</button>`;
    
    if (ourProduct) {
      html += `<div class="fc-subsection-title">Vår version</div>`;
      html += '<div class="fc-grid-2col">';
      html += renderProductCard(ourProduct, 'Doftar som...');
      
      const recommendation = getRecommendationForProduct(ourProduct);
      if (recommendation) {
        html += renderProductCard(recommendation, 'Du kanske också gillar');
      } else {
        html += '<div class="fc-product-card" style="visibility: hidden;"></div>';
      }
      html += '</div>';
    }
    
    // Visa detaljer om den riktiga parfymen
    html += `
      <div class="fc-detailed-view">
        <div class="fc-detailed-header">
          <img class="fc-detailed-image" src="${perfume.image}" alt="${perfume.name}">
          <div>
            <div class="fc-detailed-name">${perfume.name}</div>
            <div class="fc-detailed-brand">${perfume.brand}</div>
            <div class="fc-detailed-meta">${perfume.year || ''} | ${perfume.gender === 'Male' ? 'Man' : perfume.gender === 'Female' ? 'Kvinna' : 'Unisex'}</div>
          </div>
        </div>
        
        <div class="fc-notes-section">
          ${perfume.top_notes ? `
            <div class="fc-note-category">
              <h4>TOPPNOTER</h4>
              <div class="fc-note-tags">
                ${perfume.top_notes.map(note => `<span class="fc-note-tag">${note}</span>`).join('')}
              </div>
            </div>
          ` : ''}
          
          ${perfume.heart_notes ? `
            <div class="fc-note-category">
              <h4>HJÄRTNOTER</h4>
              <div class="fc-note-tags">
                ${perfume.heart_notes.map(note => `<span class="fc-note-tag">${note}</span>`).join('')}
              </div>
            </div>
          ` : ''}
          
          ${perfume.base_notes ? `
            <div class="fc-note-category">
              <h4>BASNOTER</h4>
              <div class="fc-note-tags">
                ${perfume.base_notes.map(note => `<span class="fc-note-tag">${note}</span>`).join('')}
              </div>
            </div>
          ` : ''}
        </div>
        
        <div class="fc-description">
          ${perfume.description}
        </div>
      </div>
    `;
    
    content.innerHTML = html;
  };

  // ===== UTFÖR SÖKNING =====
  function performSearch(query) {
    currentSearchQuery = query;
    content.innerHTML = '<div class="fc-loading">Söker...</div>';
    
    setTimeout(() => {
      const realPerfumes = searchRealPerfumes(query);
      const ourProducts = searchProducts(query);
      
      let html = '';
      
      // Visa riktiga parfymer först
      if (realPerfumes.length > 0) {
        html += `<div class="fc-section-title">Äkta parfymer (${realPerfumes.length})</div>`;
        
        realPerfumes.slice(0, 8).forEach(result => {
          const p = result.perfume;
          html += `
            <div class="fc-real-perfume-item" onclick="window.fcShowPerfumeDetail('${p.id}')">
              <img class="fc-real-perfume-image" src="${p.image}" alt="${p.name}" loading="lazy" onerror="this.src='https://via.placeholder.com/60x60?text=Parfym'">
              <div class="fc-real-perfume-info">
                <div class="fc-real-perfume-name">${p.name}</div>
                <div class="fc-real-perfume-brand">${p.brand}</div>
                <div class="fc-real-perfume-year">${p.year || ''}</div>
              </div>
            </div>
          `;
        });
      }
      
      // Visa våra produkter
      if (ourProducts.length > 0) {
        html += `<div class="fc-section-title">Våra produkter (${ourProducts.length})</div>`;
        
        ourProducts.slice(0, 8).forEach(match => {
          const p = match.product;
          const priceFormatted = (p.price / 100).toFixed(2).replace('.', ',') + ' kr';
          
          html += `
            <div class="fc-real-perfume-item" onclick="window.fcViewDetails('${p.url}')">
              <img class="fc-real-perfume-image" src="${p.image}" alt="${p.title}" loading="lazy" onerror="this.src='https://via.placeholder.com/60x60?text=TryScent'">
              <div class="fc-real-perfume-info">
                <div class="fc-real-perfume-name">${p.title}</div>
                <div class="fc-real-perfume-year">${priceFormatted}</div>
              </div>
            </div>
          `;
        });
      }
      
      if (realPerfumes.length === 0 && ourProducts.length === 0) {
        html = '<div class="fc-no-results">Inga produkter hittades för "' + query + '"</div>';
      }
      
      content.innerHTML = html;
    }, 300);
  }

  // ===== SÖKHANTERARE =====
  function handleSearch() {
    const query = searchInput.value.trim();
    
    if (query.length < 1) {
      if (currentView !== 'detail') {
        steps.style.display = 'block';
        content.innerHTML = '';
      }
      return;
    }
    
    steps.style.display = 'none';
    currentView = 'search';
    
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => performSearch(query), 300);
  }

  // ===== LÄGG TILL I VARUKORG =====
  window.fcAddToCart = function(variantId, event) {
    if (event) event.stopPropagation();
    
    const btn = event.target;
    const originalText = btn.innerText;
    
    btn.innerText = 'Lägger till...';
    btn.disabled = true;
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
      btn.innerText = '✓ Tillagd!';
      btn.style.background = '#2E7D32';
      
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          updateOfferDisplay(cart.item_count);
          showNotification(`✓ Tillagd! ${cart.item_count}/3 produkter för gratis present`);
        });
      
      setTimeout(() => {
        btn.innerText = originalText;
        btn.style.background = '#C41E3A';
        btn.disabled = false;
      }, 2000);
    })
    .catch(error => {
      btn.innerText = 'Fel';
      setTimeout(() => {
        btn.innerText = originalText;
        btn.disabled = false;
      }, 2000);
    });
  };

  // ===== VISA NOTIS =====
  function showNotification(message) {
    let notification = document.querySelector('.fc-notification');
    if (!notification) {
      notification = document.createElement('div');
      notification.className = 'fc-notification';
      document.body.appendChild(notification);
    }
    
    notification.textContent = message;
    notification.classList.add('show');
    
    setTimeout(() => {
      notification.classList.remove('show');
    }, 2000);
  }

  // ===== UPPDATERA ERBJUDANDE =====
  function updateOfferDisplay(itemCount) {
    if (!offerStatus || !offerProgress || !offerMessage || !offerSubtext) return;
    
    const percentage = Math.min((itemCount / 3) * 100, 100);
    offerProgress.style.width = percentage + '%';
    
    if (itemCount >= 3) {
      offerStatus.textContent = '🎉 GRATIS!';
      offerSubtext.textContent = 'Du kvalificerar dig för en gratis present!';
      offerMessage.textContent = '🎉 Du kvalificerar dig för en GRATIS present!';
      offerBanner.classList.add('qualified');
    } else {
      const needed = 3 - itemCount;
      offerStatus.textContent = `${itemCount}/3`;
      offerSubtext.textContent = `Lägg till ${needed} fler för en gratis present`;
      offerMessage.textContent = `Lägg till ${needed} fler produkter för en gratis present`;
      offerBanner.classList.remove('qualified');
    }
  }

  // ===== HÄMTA VARUKORG =====
  function fetchCartAndUpdate() {
    return fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        updateOfferDisplay(cart.item_count);
        return cart;
      })
      .catch(() => ({ item_count: 0 }));
  }

  // ===== VISA DETALJER =====
  window.fcViewDetails = function(url) {
    window.location.href = url;
  };

  // ===== GÅ TILLBAKA =====
  window.fcGoBack = function() {
    currentView = 'search';
    if (currentSearchQuery.length >= 1) {
      performSearch(currentSearchQuery);
    } else {
      steps.style.display = 'block';
      content.innerHTML = '';
    }
  };

  // ===== TOGGLE SÖKRUTA =====
  window.fcToggleSearch = function() {
    if (searchPopup.classList.contains('active')) {
      searchPopup.classList.remove('active');
    } else {
      searchPopup.classList.add('active');
      searchInput.focus();
      fetchCartAndUpdate();
    }
  };

  // ===== INIT =====
  document.addEventListener('DOMContentLoaded', function() {
    if (searchInput) {
      searchInput.addEventListener('keyup', handleSearch);
    }
    
    if (clearSearch) {
      clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.focus();
        steps.style.display = 'block';
        content.innerHTML = '';
        currentView = 'search';
      });
    }
    
    setTimeout(fetchCartAndUpdate, 500);
    
    // Stäng vid klick utanför
    document.addEventListener('click', function(event) {
      if (searchPopup && !searchPopup.contains(event.target) && 
          stickyButton && !stickyButton.contains(event.target) && 
          searchPopup.classList.contains('active')) {
        searchPopup.classList.remove('active');
      }
    });
    
    // Escape-tangent
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchPopup && searchPopup.classList.contains('active')) {
        searchPopup.classList.remove('active');
      }
    });
    
    // Förhindra att klick inuti popupen stänger den
    if (searchPopup) {
      searchPopup.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }
  });
})();
</script>