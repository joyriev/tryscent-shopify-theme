        const brandLower = product.brand.toLowerCase();
        const normalizedBrand = normalizeText(brandLower);
        const normalizedExpansion = normalizeText(brandExpansion);
        
        if (normalizedBrand === normalizedExpansion || brandLower === normalizedExpansion) {
          bestScore = 500;
          matchReasons.push('brand-abbreviation-match');
        }
      }
      
      // ===== EXACT NUMBER MATCH =====
      if (isNumberQuery && product.number && product.number.toString() === queryAsNumber) {
        bestScore = 500;
        matchReasons.push('exact-number-match');
      }
      
      // Generate fuzzy variations of product fields
      const titleVariations = generateFuzzyVariations(product.title).slice(0, 5);
      const brandVariations = generateFuzzyVariations(product.brand).slice(0, 5);
      
      // Check each search variant
      for (const variant of searchVariants) {
        if (variant.length < 1) continue;
        
        // Check number
        if (product.number) {
          const numberStr = product.number.toString();
          if (variant === numberStr) {
            bestScore = Math.max(bestScore, 450);
