  // ===== HITTA REKOMMENDERAD PRODUKT =====
  function getRecommendationForProduct(product) {
    if (!product || !product.number) return null;
    
    const productsToSearch = allPerfumes.length > 0 ? allPerfumes : hardcodedProducts;
    
    // Kolla om det finns en hårdkodad rekommendation för detta produktnummer
    const recNumber = hardcodedRecommendations[product.number];
    if (recNumber) {
      const recommended = productsToSearch.find(p => p.number === recNumber || p.productNumbers?.includes(recNumber));
      if (recommended && recommended.id !== product.id) {
        return recommended;
      }
    }
    
    // Fallback: annan produkt från samma brand
    const sameBrand = productsToSearch.find(p => 
      (p.brandKey === product.brandKey || p.brand === product.brand) && 
      p.id !== product.id &&
      p.gender === product.gender
    );
    
    return sameBrand || null;
  }

  // ===== NORMALISERA TEXT FÖR SÖKNING =====
  function normalizeText(text) {
    if (!text) return '';
    return text.toLowerCase()
      .replace(/[åä]/g, 'a')
      .replace(/[ö]/g, 'o')
      .replace(/[''`´,.;:!?()\-]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  // ===== UTFÖR SÖKNING =====
  function searchProducts(query) {
    if (!query || query.length < 1) return [];
    
    const normalizedQuery = normalizeText(query);
    const results = [];
    const addedIds = new Set();
    
    // Use dynamic catalog if available, fallback to hardcoded
    const productsToSearch = allPerfumes.length > 0 ? allPerfumes : hardcodedProducts;
    
    productsToSearch.forEach(product => {
      // Sök i titel
      const titleNorm = normalizeText(product.title);
      if (titleNorm.includes(normalizedQuery) || normalizedQuery.includes(titleNorm)) {
        if (!addedIds.has(product.id)) {
          results.push({ product, score: 100 });
          addedIds.add(product.id);
          return;
        }
      }
      
      // Sök i produktnummer
      if (product.number && product.number.toString() === query) {
        if (!addedIds.has(product.id)) {
          results.push({ product, score: 95 });
          addedIds.add(product.id);
          return;
        }
      }
      
      // Sök i searchTerms
      if (product.searchTerms) {
        for (const term of product.searchTerms) {
          if (normalizeText(term).includes(normalizedQuery)) {
            if (!addedIds.has(product.id)) {
              results.push({ product, score: 90 });
              addedIds.add(product.id);
              return;
            }
          }
        }
      }
      
      // Sök i brand
      const brandNorm = normalizeText(product.brand);
      if (brandNorm.includes(normalizedQuery)) {
        if (!addedIds.has(product.id)) {
          results.push({ product, score: 85 });
          addedIds.add(product.id);
          return;
        }
      }
    });
    
    return results.sort((a, b) => b.score - a.score);
  }

  // ===== RENDERA PRODUKTKORT =====
  function renderProductCard(product, badge) {
    const priceFormatted = (product.price / 100).toFixed(2).replace('.', ',') + ' kr';
    
    return `
      <div class="fc-product-card">
        <div class="fc-badge">${badge}</div>
        <div class="fc-product-inner">
          <img class="fc-product-image" src="${product.image}" alt="${product.title}" loading="lazy">
          <div class="fc-product-title">${product.title}</div>
          <div class="fc-product-price">${priceFormatted}</div>
          <button class="fc-add-to-cart" onclick="event.stopPropagation(); window.fcAddToCart('${product.url}', ${product.variant}, event)">Lägg i varukorg</button>
          <div>
            <span class="fc-view-link" onclick="event.stopPropagation(); window.fcViewDetails('${product.url}')">Se detaljer</span>
          </div>
        </div>
      </div>
    `;
  }

  // ===== RENDERA SÖKRESULTAT =====
  function renderSearchResults(query) {
    const results = searchProducts(query);
    
    if (results.length === 0) {
      return '<div class="fc-no-results">Inga produkter hittades för "' + query + '"</div>';
    }
    
    let html = `<div class="fc-section-title">Produkter (${results.length})</div>`;
    
    results.slice(0, 10).forEach(match => {
      const p = match.product;
      const priceFormatted = (p.price / 100).toFixed(2).replace('.', ',') + ' kr';
      
      html += `
        <div class="fc-real-perfume-item" onclick="window.fcViewDetails('${p.url}')">
          <img class="fc-real-perfume-image" src="${p.image}" alt="${p.title}" loading="lazy">
          <div class="fc-real-perfume-info">
            <div class="fc-real-perfume-name">${p.title}</div>
            <div class="fc-real-perfume-brand">${p.brand}</div>
            <div class="fc-real-perfume-year">${priceFormatted}</div>
          </div>
        </div>
      `;
    });
    
    return html;
  }

  // ===== VISA PRODUKTDETALJ MED REKOMMENDATION =====
  window.fcViewDetails = function(url) {
    window.location.href = url;
  };

  window.fcShowProductDetail = function(productId) {
    const productsToSearch = allPerfumes.length > 0 ? allPerfumes : hardcodedProducts;
    const product = productsToSearch.find(p => p.id === productId);
    if (!product) return;
    
    currentView = 'detail';
    document.getElementById('fcSteps').style.display = 'none';
    
    const recommendation = getRecommendationForProduct(product);
    
    let html = `
      <button class="fc-back-btn" onclick="window.fcGoBack()">Tillbaka</button>
      <div class="fc-subsection-title">${product.title}</div>
      <div class="fc-grid-2col">
    `;
    
    // Visa aktuell produkt
    html += renderProductCard(product, 'Vald produkt');
    
    // Visa rekommendation om den finns
    if (recommendation) {
      html += renderProductCard(recommendation, 'Du kanske också gillar');
    } else {
      html += '<div class="fc-product-card" style="visibility: hidden;"></div>';
    }
    
    html += '</div>';
    document.getElementById('fcContent').innerHTML = html;
  };

  // ===== LÄGG TILL I VARUKORG =====
  window.fcAddToCart = function(url, variantId, event) {
    if (event) event.stopPropagation();
    
    const btn = event.target;
    const originalText = btn.innerText;
    
    btn.innerText = 'Lägger till...';
    btn.disabled = true;
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
      btn.innerText = '✓ Tillagd!';
      btn.style.background = '#2E7D32';
      
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          updateOfferDisplay(cart.item_count);
          showNotification(`✓ Tillagd! ${cart.item_count}/3 produkter för gratis present`);
        });
      
      setTimeout(() => {
        btn.innerText = originalText;
        btn.style.background = '#C41E3A';
        btn.disabled = false;
      }, 2000);
    })
    .catch(error => {
      btn.innerText = 'Fel';
      setTimeout(() => {
        btn.innerText = originalText;
        btn.disabled = false;
      }, 2000);
    });
  };

  // ===== VISA NOTIS =====
  function showNotification(message) {
    let notification = document.querySelector('.fc-notification');
    if (!notification) {
      notification = document.createElement('div');
      notification.className = 'fc-notification';
      document.body.appendChild(notification);
    }
    
    notification.textContent = message;
    notification.classList.add('show');
    
    setTimeout(() => {
      notification.classList.remove('show');
    }, 2000);
  }

  // ===== UPPDATERA ERBJUDANDE =====
  function updateOfferDisplay(itemCount) {
    const offerStatus = document.getElementById('fcOfferStatus');
    const offerProgress = document.getElementById('fcOfferProgress');
    const offerMessage = document.getElementById('fcOfferMessage');
    const offerSubtext = document.getElementById('fcOfferSubtext');
    const offerBanner = document.getElementById('fcOfferBanner');
    
    if (!offerStatus) return;
    
    const percentage = Math.min((itemCount / 3) * 100, 100);
    if (offerProgress) offerProgress.style.width = percentage + '%';
    
    if (itemCount >= 3) {
      offerStatus.textContent = '🎉 GRATIS!';
      if (offerSubtext) offerSubtext.textContent = 'Du kvalificerar dig för en gratis present!';
      if (offerMessage) offerMessage.textContent = '🎉 Du kvalificerar dig för en GRATIS present!';
      if (offerBanner) offerBanner.classList.add('qualified');
    } else {
      const needed = 3 - itemCount;
      offerStatus.textContent = `${itemCount}/3`;
      if (offerSubtext) offerSubtext.textContent = `Lägg till ${needed} fler för en gratis present`;
      if (offerMessage) offerMessage.textContent = `Lägg till ${needed} fler produkter för en gratis present`;
      if (offerBanner) offerBanner.classList.remove('qualified');
    }
  }

  // ===== HÄMTA VARUKORG =====
  function fetchCartAndUpdate() {
    return fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        updateOfferDisplay(cart.item_count);
        return cart;
      })
      .catch(() => ({ item_count: 0 }));
  }

  // ===== SÖKHANTERARE =====
  let searchTimer;
  let currentView = 'search';

  function handleSearch() {
    const query = document.getElementById('fcSearchInput').value.trim();
    
    if (query.length < 1) {
      if (currentView !== 'detail') {
        document.getElementById('fcSteps').style.display = 'block';
        document.getElementById('fcContent').innerHTML = '';
      }
      return;
    }
    
    document.getElementById('fcSteps').style.display = 'none';
    currentView = 'search';
    
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      document.getElementById('fcContent').innerHTML = renderSearchResults(query);
    }, 300);
  }

  // ===== GÅ TILLBAKA =====
  window.fcGoBack = function() {
    currentView = 'search';
    document.getElementById('fcSteps').style.display = 'block';
    document.getElementById('fcContent').innerHTML = '';
  };

  // ===== TOGGLE SÖKRUTA =====
  window.fcToggleSearch = function() {
    const popup = document.getElementById('fcSearchPopup');
    if (popup.classList.contains('active')) {
      popup.classList.remove('active');
    } else {
      popup.classList.add('active');
      document.getElementById('fcSearchInput').focus();
      fetchCartAndUpdate();
    }
  };

  // ===== INIT =====
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('fcSearchInput');
    const clearSearch = document.getElementById('fcClearSearch');
    
    if (searchInput) {
      searchInput.addEventListener('keyup', handleSearch);
    }
    
    if (clearSearch) {
      clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.focus();
        document.getElementById('fcSteps').style.display = 'block';
        document.getElementById('fcContent').innerHTML = '';
        currentView = 'search';
      });
    }
    
    setTimeout(fetchCartAndUpdate, 500);
    
    // Stäng vid klick utanför
    document.addEventListener('click', function(event) {
      const popup = document.getElementById('fcSearchPopup');
      const button = document.getElementById('fcStickyButton');
      
      if (popup && popup.contains(event.target)) return;
      if (button && button.contains(event.target)) return;
      
      if (popup && popup.classList.contains('active')) {
        popup.classList.remove('active');
      }
    });
    
    // Escape-tangent
    document.addEventListener('keydown', function(e) {
      const popup = document.getElementById('fcSearchPopup');
      if (e.key === 'Escape' && popup && popup.classList.contains('active')) {
        popup.classList.remove('active');
      }
    });
  });
})();
