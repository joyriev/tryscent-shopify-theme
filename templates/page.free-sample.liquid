{% layout 'theme' %}

<div id="shopify-section-template--19610512916550__homepage_hero_GDeBtq" class="shopify-section homepage-hero">

  <style data-shopify>
    .section-template--19610512916550__homepage_hero_GDeBtq-padding {
      padding-top: 36px;
      padding-bottom: 400px;
      background-image: url("/cdn/shop/files/tryscent-mobile-home-bg.png?v=1769175064&width=1920");
      background-color: #faf9f6;
    }

    @media screen and (min-width: 750px) {
      .section-template--19610512916550__homepage_hero_GDeBtq-padding {
        padding-top: 80px;
        padding-bottom: 80px;
        background-image: url("/cdn/shop/files/banner_b437ab73-972d-433d-922b-817e1168a76c.webp?v=1769165143&width=1920");
      }
