{% layout 'theme' %}

<div id="shopify-section-template--19610512916550__homepage_hero_GDeBtq" class="shopify-section homepage-hero">

  <style data-shopify>
    .section-template--19610512916550__homepage_hero_GDeBtq-padding {
      padding-top: 36px;
      padding-bottom: 700px;
      background-image: url("/cdn/shop/files/tryscent-mobile-home-bg.png?v=1769175064&width=1920");
      background-color: #faf9f6;
    }

    @media screen and (min-width: 750px) {
