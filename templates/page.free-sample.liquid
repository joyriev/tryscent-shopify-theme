  </style>

  <div id="template--19610512916550__homepage_hero_GDeBtq" class="section-template--19610512916550__homepage_hero_GDeBtq-padding bg-cover bg-center">

    <div class="page-width">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 itm">

        <!-- LEFT CONTENT -->
        <div class="flex-1 text-center lg:text-left">

          <!-- Rating Badge -->
          <div class="inline-flex items-center bg-white rounded-full px-4 py-1.5 mb-8 shadow-sm">
            <div class="flex text-[#FFB800] mr-2">
              <!-- 5 Stars -->
              {% for i in (1..5) %}
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              {% endfor %}
            </div>
            <span class="text-xs font-bold text-gray-700">
              5,000+ Happy TryScent explorers
            </span>
          </div>

          <!-- Heading -->
          <h1 class="text-4xl md:text-4xl font-serif leading-[1.1] mt-0 mb-6 text-[#333]">
            Get A
            <span class="bg-[#137c44] text-white px-3 py-1 italic inline-block transform -rotate-1 mx-1">
              FREE Sample Box
            </span>
            Of <br class="hidden md:block">
            Luxury Scents
          </h1>

          <p class="text-[#137c44] font-medium text-lg mb-8">
            3 x Premium Decants (your choice of vibes)
          </p>

          <!-- Steps Section -->
          <div class="bg-[#EFEBE5] rounded-xl p-8 mb-8 relative border border-[#DED9D1] space-y-3 text-left">
            <div class="flex items-center">
              <span class="w-8 h-8 rounded-full bg-[#137c44] text-white flex items-center justify-center font-black italic mr-4">1</span>
              <p class="font-medium text-gray-800 my-0">Up To 70% Off Retail Prices</p>
            </div>

            <div class="flex items-center">
              <span class="w-8 h-8 rounded-full bg-[#137c44] text-white flex items-center justify-center font-black italic mr-4">2</span>
              <p class="font-medium text-gray-800 my-0">
                Free shipping orders $49+ | Free gifts available
              </p>
            </div>

            <div class="flex items-center">
              <span class="w-8 h-8 rounded-full bg-[#137c44] text-white flex items-center justify-center font-black italic mr-4">3</span>
              <p class="font-medium text-gray-800 my-0">
                Start with samples &amp; expert ideas
              </p>
            </div>
          </div>

          <!-- CTA -->
          <div class="mb-4">
            <button class="w-full bg-[#137c44] border-0 text-white font-black uppercase tracking-widest py-6 px-10 rounded-full text-lg md:text-xl shadow-lg hover:bg-[#0e743d] transition-transform hover:scale-[1.02] flex items-center justify-center">
              YES! I WANT MY FREE SAMPLES
              <span class="ml-2">→</span>
            </button>
          </div>

          <p class="text-[10px] text-gray-500 uppercase font-bold tracking-wider max-w-md mx-auto lg:mx-0">
            Limited Offer - ONE Per Customer Only. While quantities last.                      
            Receive 3 premium scent decants. Just Pay Shipping.
          </p>

        </div>

        <!-- RIGHT SIDE (EMPTY FOR NOW) -->
        <div class="text-center"></div>

      </div>
    </div>
  </div>
</div>